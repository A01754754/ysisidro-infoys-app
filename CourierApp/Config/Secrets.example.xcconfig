// Copy this file to Secrets.xcconfig and replace the placeholder locally.
// Never commit Secrets.xcconfig.
MBX_ACCESS_TOKEN = YOUR_PUBLIC_MAPBOX_ACCESS_TOKEN
ELEVENLABS_AGENT_ID = YOUR_PUBLIC_ELEVENLABS_AGENT_ID
// Leave empty to use CourierApp/Resources/dev2-courier-state.json.
// In xcconfig, write URLs as http:/$()/localhost:3000.
DEV2_BASE_URL = http:/$()/localhost:3000
// Local secrets. This file is gitignored — do not commit it.
MBX_ACCESS_TOKEN = pk.eyJ1IjoibWF4aG1yIiwiYSI6ImNtdHlsejhhbDBobjUyeHBtMWtmNGp4bXkifQ.su1pYTPS5yCnqVeoFMLKyQ
ELEVENLABS_AGENT_ID = agent_0401m2bvdym1f0ds9feb2vd1h6fk
// Base URL of the Go simulator. Leave empty to use the bundled
// CourierApp/Resources/dev2-courier-state.json fixture instead.
// The $() is required: in xcconfig a bare // starts a comment.
// On a physical iPhone replace localhost with the Mac's LAN IP.
DEV2_BASE_URL = http:/$()/localhost:3000
