<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>MBXAccessToken</key>
	<string>$(MBX_ACCESS_TOKEN)</string>
	<key>DEV2_STATE_URL</key>
	<string>$(DEV2_STATE_URL)</string>
	<key>ELEVENLABS_AGENT_ID</key>
	<string>$(ELEVENLABS_AGENT_ID)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>La app se conecta al servicio local de DEV2 para recibir el estado del repartidor.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Usamos el micrófono para hablar con el asistente de voz del repartidor.</string>
</dict>
</plist>
